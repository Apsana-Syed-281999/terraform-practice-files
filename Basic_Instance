provider "aws" {
  region = "us-east-1"
}


#####3 Inst #####
resource "aws_instance" "myinstance" {
  tags = {
    Name        = "Terra-Inst"
    Environment = "dev"
  }
  ami               = "ami-09bf9dfeeb1e9adbc"
  instance_type     = "t3.micro"
  availability_zone = "us-east-1a"
  key_name          = "CICDkey"
  root_block_device {
    volume_size = 8
  }
  count = 2
}

