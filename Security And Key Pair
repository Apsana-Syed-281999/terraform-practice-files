#### Pro ####
provider "aws" {
  region = "us-east-1"
}


#### Inst #####
resource "aws_instance" "myInst" {
  tags = {
    Name = "Virginia-Inst"
  }
  ami                    = "ami-09bf9dfeeb1e9adbc"
  instance_type          = "t3.micro"
  key_name               = aws_key_pair.myKP.key_name
  vpc_security_group_ids = [aws_security_group.mySG.id]
  availability_zone      = "us-east-1b"
  root_block_device {
    volume_size = 10
  }
}


##### SG ######

resource "aws_security_group" "mySG" {
  name        = "Terra-SG"
  description = "SG for instance my-SG"

  ingress {
    from_port   = "80"
    to_port     = "80"
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = "22"
    to_port     = "22"
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = "0"
    to_port     = "0"
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}



#####   ssh-keygen --> command to create the publick and private keys  ####

###### Key Pair #####
resource "aws_key_pair" "myKP" {
  key_name   = "Terra-KP"
  public_key = file("/root/.ssh/id_rsa.pub")
}
